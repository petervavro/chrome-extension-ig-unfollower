{
  "manifest_version": 3,
  "name": "IG Unfollower",
  "description": "Automate unfollowing Instagram accounts directly from your browser. Runs on your profile page with human-like random delays.",
  "version": "1.0.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "IG Unfollower — navigate to your Instagram profile to begin",
    "default_icon": "images/icon-128.png",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/libs/unfollow.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ]
}
